{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name":"Python Debugger: Module",
            "type":"debugpy",
            "request":"launch",
            "module":"xlpro.run_server",
            "args": [
                "--debugpy_port=5678"
            ]
        },
        {
            "name":"debugpy: remote 5678",
            "type":"debugpy",
            "request":"attach",
            "subProcess": true,
            "connect":{
                "host":"localhost",
                "port":5678
            },
            "pathMappings":[
                {
                    "localRoot":"${workspaceFolder}",
                    "remoteRoot":"${workspaceFolder}",
                }
            ]
        },
        {
            "name":"debugpy: current",
            "type":"debugpy",
            "request":"launch",
            "program":"${file}",
            "console":"integratedTerminal"
        },
        {
            "name": "debugpy: pid",
            "type": "debugpy",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "go: launch file here",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${file}"
        },
        {
            "name": "go: launch file at workspace root",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${file}",
            "cwd": "${workspaceFolder}"
        },
    ]
}