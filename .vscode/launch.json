            "name":"debug main",
            "type":"debugpy",
            "request":"launch",
            "program":"main.py",
        },
        {
            "name":"Python Debugger: Current File absolute path",
            "type":"debugpy",
            "request":"launch",
            "program":"${file}",
            "console":"integratedTerminal",
            "cwd": "C:/Users/Daniel Evans",
        },
        {
            "name":"xlpro_cli.main init",
            "type":"debugpy",
            "request":"launch",
            "program":"xlpro_cli/main.py",
            "args": [
