{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name":"debugpy: remote 5678",
            "type":"debugpy",
            "request":"attach",
            "connect":{
                "host":"localhost",
                "port":5678
            },
            "pathMappings":[
                {
                    "localRoot":"${workspaceFolder}",
                    "remoteRoot":"."
                }
            ]
        },
        {
            "name": "go launch file",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${file}"
        },
        {
            "name":"debugpy: current",
            "type":"debugpy",
            "request":"launch",
            "program":"${file}",
            "console":"integratedTerminal"
        },
        {
            "name": "debugpy: pid",
            "type": "debugpy",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}