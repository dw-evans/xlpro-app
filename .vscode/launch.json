        {
            "name":"debugpy: remote port",
            "type":"debugpy",
            "request":"attach",
            "subProcess": true,
            "connect":{
                "host":"localhost",
                "port":63645
            },
            "pathMappings":[
                {
                    "localRoot":"${workspaceFolder}",
                    "remoteRoot":"${workspaceFolder}",
                }
            ]
        },
        {
            "name":"debugpy: current",
            "type":"debugpy",
            "request":"launch",
            "program":"${file}",
            "console":"integratedTerminal"
        },
        {
            "name": "debugpy: pid",
            "type": "debugpy",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "go: launch file here",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${file}"
        },
        {
            "name": "go: launch file at workspace root",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${file}",
            "cwd": "${workspaceFolder}"
        },
    ]
}