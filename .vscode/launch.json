    "version": "0.2.0",
    "configurations": [
    
        {
            "name":"debug main",
            "type":"debugpy",
            "request":"launch",
            "program":"main.py",
        },
        {
            "name":"Python Debugger: Current File absolute path",
            "type":"debugpy",
            "request":"launch",
            "program":"${file}",
            "console":"integratedTerminal",
            "cwd": "C:/Users/Daniel Evans",
        },
        {
            "name":"xlpro_cli.main init",
            "type":"debugpy",
            "request":"launch",
            "program":"xlpro_cli/main.py",
            "args": [
                "init",
                // "C:/Users/Daniel Evans/projects/xlpro/xlpro_examples/xlpro-ex01-basics.xlsx"
                "C:/Users/Daniel Evans/projects/xlpro/xlpro_examples/xlpro-ex01-basics.xlsx"

            ],
        },
        {
            // BE AWARE THAT START IS NOT ABLE TO TRIGGER SYNC ANYMORE
            "name":"xlpro_cli.main start",
            "type":"debugpy",
            "request":"launch",
            "program":"xlpro_cli/main.py",
            "args": [
                "start",
                
                "C:/Users/Daniel Evans/projects/xlpro/xlpro_examples/xlpro-ex01-basics.xlsx"
            ],
        },
        {
            "name":"xlpro_cli.main guid",
            "type":"debugpy",
            "request":"launch",
            "program":"xlpro_cli/main.py",
            "args": [
                "guid",
                "C:/Users/Daniel Evans/projects/xlpro/xlpro_examples/xlpro-ex01-basics.xlsx"
            ],
        },
        {
            "name":"xlpro_cli.main write-reqs",
            "type":"debugpy",
            "request":"launch",
            "program":"xlpro_cli/main.py",
            "args": [
                "write-reqs",
                "C:/Users/Daniel Evans/projects/xlpro/xlpro_examples/xlpro-ex01-basics.xlsx"
            ],
        },
        {
            "name":"xlpro_cli.main clear-tmp",
            "type":"debugpy",
            "request":"launch",
            "program":"xlpro_cli/main.py",
            "args": [
                "clear-tmp",
            ],
        },
        {
            "name":"xlpro_cli.main clear-venvs",
            "type":"debugpy",
            "request":"launch",
            "program":"xlpro_cli/main.py",
            "args": [
                "clear-venvs",
            ],
        },
        {
            "name":"debugpy: remote port",
            "type":"debugpy",
            "request":"attach",
            "subProcess": true,
            "connect":{
                "host":"localhost",
                "port":5678
            },
            "pathMappings":[
                {
                    "localRoot":"${workspaceFolder}",
                    "remoteRoot":"${workspaceFolder}",
                }
            ]
        },
        {
            "name":"debugpy: current",
            "type":"debugpy",
            "request":"launch",
            "program":"${file}",
            "console":"integratedTerminal"
        },
        {
            "name": "debugpy: pid",
            "type": "debugpy",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "go: launch file here",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${file}"
        },
        {
            "name": "go: launch file at workspace root",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${file}",
            "cwd": "${workspaceFolder}"
        },
    ]
}