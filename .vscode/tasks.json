{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "go compile xlpro",
            "type": "shell",
            "command": "go",
            "args": [
              "build",
              "-o",
              "xlpro.exe",
              "src/main.go"
            ],
            "group": {
              "kind": "build",
              "isDefault": true
            },
            "problemMatcher": ["$go"],
            "options": {
              "cwd": "${workspaceFolder}"
            }
          }
    ]
}