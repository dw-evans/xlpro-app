{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "xlpro_cli build",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/scripts/pyinstaller.exe",
        "args": [
          "main.spec"
        ],
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "problemMatcher": [],
        "options": {
          "cwd": "${workspaceFolder}/xlpro_cli"
        }
      },

      {
        "label": "xlpro sync version",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/scripts/python.exe",
        "args": [
          "${workspaceFolder}/xlpro/sync_version.py"
        ],
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "dependsOn": [],
        "dependsOrder": "sequence",
        "problemMatcher": [],
        "options": {
          "cwd": "${workspaceFolder}/xlpro"
        }
      },

      {
        "label": "xlpro build wheel",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/scripts/python.exe",
        "args": [
          "-m",
          "build",
          "--wheel"
        ],
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "dependsOn": [
          "xlpro sync version"
        ],
        "dependsOrder": "sequence",
        "problemMatcher": [],
        "options": {
          "cwd": "${workspaceFolder}/xlpro"
        }
      },

      {
        "label": "xlpro_installer_inno pre_pre_build",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/scripts/python.exe",
        "args": [
          "pre_pre_build.py"
        ],
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "problemMatcher": [],
        "options": {
          "cwd": "${workspaceFolder}/xlpro_installer_inno"
        }
      },

      {
        "label": "xlpro_addin compile and push",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/scripts/python.exe",
        "args": [
          "main.py",
          "--build",
          "--push"
        ],
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "dependsOn": [],
        "dependsOrder": "sequence",
        "problemMatcher": [],
        "options": {
          "cwd": "${workspaceFolder}/xlpro_addin"
        }
      },

      {
        "label": "xlpro_shell_wrapper rsrc",
        "type": "shell",
        "command": "rsrc",
        "args": [
          "-arch",
          "amd64",
          "-ico",
          "favicon.ico"
        ],
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "options": {
          "cwd": "${workspaceFolder}/xlpro_cli_shell_wrapper"
        },
      },

      {
        "label": "xlpro_installer_inno pre_build",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/scripts/python.exe",
        "args": [
          "pre_build.py"
        ],
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "problemMatcher": [],
        "options": {
          "cwd": "${workspaceFolder}/xlpro_installer_inno"
        },
        "dependsOn": [],
        "dependsOrder": "sequence",
      },

      {
        "label": "xlpro_installer_inno build",
        "type": "shell",
        "command": "C:/Program Files (x86)/Inno Setup 6/ISCC.exe",
        "args": [
          "build_installer.iss"
        ],
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "problemMatcher": [],
        "options": {
          "cwd": "${workspaceFolder}/xlpro_installer_inno"
        },
        "dependsOn": [
          "xlpro_installer_inno pre_pre_build",
          "xlpro_installer_inno pre_build"
        ],
        "dependsOrder": "sequence",
      },
      
      {
        "type": "go",
        "label": "xlpro_shell_wrapper go build xlpro-server",
        "command": "build",
        "args": [
          // "-ldflags=-H windowsgui",
          "-o",
          "xlpro-server.exe",
        ],
        "problemMatcher": [
          "$go"
        ],
        "dependsOn": [
          "xlpro_shell_wrapper rsrc",
        ],
        "dependsOrder": "sequence",
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "options": {
          "cwd": "${workspaceFolder}/xlpro_cli_shell_wrapper"
        },
        // "detail": "cd c:\\Users\\Daniel Evans\\projects\\xlpro\\xlpro_cli_shell_wrapper; go build main.go"
      },
      {
        "label": "XLPRO BUILD ALL",
        "problemMatcher": [],
        "dependsOrder": "sequence",
        "dependsOn": [
          "xlpro_addin compile and push",
          "xlpro build wheel",
          "xlpro_cli build",
          "xlpro_shell_wrapper go build xlpro-server",
          "xlpro_installer_inno build"
        ]
      },
      

    ]
}