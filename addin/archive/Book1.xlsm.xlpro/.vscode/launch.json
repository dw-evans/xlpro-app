{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "xlpro debugpy",
      "type": "debugpy",
      "request": "attach",
      "subProcess": true,
      "connect": {
        "host": "localhost",
        "port": 63719
      },
      "pathMappings": [
        {
          "localRoot": "${{workspaceFolder}}",
          "remoteRoot": "${{workspaceFolder}}"
        }
      ]
    }
  ]
}