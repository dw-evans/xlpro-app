<!-- <customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" loadImage="OnLoadImage">  -->
<!-- <customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" loadImage="OnLoadImage">  -->
<!-- <customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" loadImage="OnLoadImage">  -->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" > 
  <ribbon startFromScratch="false"> 
    <tabs> 
      <tab id="CustomTab" label="xlpro"> 
        <group id="group1" label=" ">
        <!-- <button id="Button1" image="xlpro-logo-32" size="large"  -->
        <button id="Button1" image="xl-icon_0_64" size="large" 
                  label="Initialize" 
                  screentip="Initialize" 
                  onAction="xlproInit"/> 

        </group> 
        <group id="group2" label=" "> 
          <button id="Button2" image="play-24_1_64" size="large" 
                  label="Start" 
                  screentip="Start Server" 
                  onAction="xlproStart"/> 
                  
          <button id="Button3" image="sync-24_1_64" size="large" 
                  label="Sync" 
                  screentip="Sync" 
                  onAction="xlproRegister"/> 

          <button id="Button4" image="file-code-24_1_64" size="large" 
                  label="Develop" 
                  screentip="Edit the xlpro project in VSCode" 
                  onAction="xlproStartIDE"/> 

        </group> 
        <group id="group5" label=" "> 
          <button id="Button8a" image="undo-24_1_64" size="large" 
                  label="Undo" 
                  screentip="Backup Undo" 
                  onAction="ButtonPerformUndo"/> 

          <button id="Button9" image="redo-24_1_64" size="large" 
                  label="Redo" 
                  screentip="Backup Redo" 
                  onAction="ButtonPerformRedo"/> 

          <button id="Button11" image="bug-24_1_64"  size="large"
                  label="Restart Undo Tracker" 
                  screentip="x" 
                  onAction="ResetUndoButton"/> 
        </group> 
        <group id="group6" label=" "> 

          <button id="Button10" image="sync-16_0_48" 
                  label="Recalculate Selected" 
                  screentip="Forces a full recalculations of the current selected range" 
                  onAction="force_refresh_area_calculationButton"/> 

          <button id="Button6b" image="database-16_0_48" 
                  label="Push Requirements" 
                  screentip="Push the Python requirements to the workspace folder" 
                  onAction="PushRequirementsTxtButton"/> 

          <button id="Button7" image="file-directory-16_0_48" 
                  label="Show Working Directory" 
                  screentip="Shows the working directory" 
                  onAction="OpenWorkingDirButton"/> 
        </group> 
        <group id="group4a" label=" "> 
                <menu id="manageDropDown" label="Manage xlpro Application" image="gear-24_1_64" size="large">

                        <button id="Button5a" image="sliders-16_0_48" 
                                label="Edit Global Config (toml)" 
                                screentip="Edit the xlpro desktop application configuration" 
                                onAction="EditConfigGlobalButton"/> 

                        <button id="Button7a" image="file-directory-16_0_48" 
                                label="Show /.xlpro" 
                                screentip="Shows the xlpro installation folder" 
                                onAction="OpenXlproInstallDirButton"/> 

                        <button id="ClearVenvDataButton" image="repo-deleted-16_0_48" 
                                label="Clear All Python Environments" 
                                screentip="Deletes all xlpro virtual environments. Use to reduce installation folder size" 
                                onAction="ClearVenvDataButton"/> 

                        <button id="ClearTempDataButton" image="repo-deleted-16_0_48" 
                                label="Clear All Temporary Files" 
                                screentip="Deletes all temporary xlpro files. Use to reduce installation folder size" 
                                onAction="ClearTempDataButton"/> 

                        <button id="ClearUvPythonsButton" image="repo-deleted-16_0_48" 
                                label="uv: Clear Python" 
                                screentip="Clears the python cache" 
                                onAction="ClearUvPythonsButton"/> 

                        <button id="ClearUvCacheButton" image="repo-deleted-16_0_48" 
                                label="uv: Clear Cache" 
                                screentip="Clears the uv cache" 
                                onAction="ClearUvCacheButton"/> 

                        <button id="RemoveLinkForThisWorkbookButton" image="repo-deleted-16_0_48" 
                                label="Break Workbook Venv Link" 
                                screentip="Clears the uv cache" 
                                onAction="RemoveLinkForThisWorkbookButton"/> 

                        <button id="ClearUnusedVenvsButton" image="repo-deleted-16_0_48" 
                                label="Clear All Temporary Files" 
                                screentip="Clears the uv cache" 
                                onAction="ClearUnusedVenvsButton"/>
                                
                </menu> 
        </group>
      </tab> 
    </tabs> 
  </ribbon> 
</customUI> 